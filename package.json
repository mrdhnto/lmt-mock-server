{
  "name": "lmt-report-server",
  "description": "Cloudflare Worker + D1 backend for LMT anonymous-report telemetry (Supabase replacement).",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:local": "wrangler d1 execute lmt-reports --local --file=./schema.sql",
    "d1:remote": "wrangler d1 execute lmt-reports --remote --file=./schema.sql",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
